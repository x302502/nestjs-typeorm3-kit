{
  "name": "nestjs-typeorm3-kit",
  "version": "0.2.1",
  "description": "NestJS utilities for TypeORM v0.3+",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.config.json",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./tests/jest.config.json --detectOpenHandles",
    "prepare": "yarn build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x302502/nestjs-typeorm3-kit.git"
  },
  "keywords": [
    "nestjs-typeorm3-kit",
    "custom repository typeorm 0.3x",
    "support multiple connection",
    "nestjs",
    "typeorm",
    "typeorm 0.3",
    "nestjs typeorm",
    "typeorm transaction",
    "nestjs repository",
    "nestjs database",
    "nestjs module",
    "database wrapper",
    "decorator",
    "unit of work",
    "repository pattern",
    "nestjs-typeorm"
  ],
  "author": "thanhluan.bkhn <thanhluan.bkhn@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/x302502/nestjs-typeorm3-kit/issues"
  },
  "homepage": "https://github.com/x302502/nestjs-typeorm3-kit#readme",
  "engines": {
    "node": ">=16.4.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=8.0.0 <13.0.0",
    "@nestjs/core": ">=8.0.0 <13.0.0",
    "@nestjs/typeorm": ">=9.0.0 <13.0.0",
    "@nestjs/swagger": ">=5.0.0 <13.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "class-validator-jsonschema": "^5.0.2",
    "libphonenumber-js": "^1.10.20",
    "reflect-metadata": ">=0.1.13 <0.3.0",
    "rxjs": ">=7.2.0 <8.0.0",
    "typeorm": ">=0.3.0 <1.0.0"
  },
  "dependencies": {
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/testing": "^12.1.3",
    "@nestjs/typeorm": "^12.0.2",
    "@types/jest": "^30.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "class-validator-jsonschema": "^5.0.2",
    "eslint": "^9.29.0",
    "jest": "^30.0.3",
    "libphonenumber-js": "^1.12.9",
    "prettier": "^3.6.2",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "sql.js": "^1.14.2",
    "ts-jest": "^29.4.14",
    "typeorm": "^0.3.31",
    "typescript": "^5.8.3"
  }
}
