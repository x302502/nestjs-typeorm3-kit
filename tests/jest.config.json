{
	"moduleFileExtensions": ["js", "json", "ts"],
	"rootDir": "./",
	"testRegex": ".*\\.spec\\.ts$",
	"extensionsToTreatAsEsm": [".ts"],
	"transform": {
		"^.+\\.tsx?$": ["ts-jest", { "useESM": true, "tsconfig": { "module": "ESNext", "moduleResolution": "node" } }]
	},
	"collectCoverageFrom": ["**/*.(t|j)s"],
	"coverageDirectory": "../coverage",
	"testEnvironment": "node"
}
